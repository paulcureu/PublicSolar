# Trimiterea formularelor pe e-mail (prin Resend — https://resend.com)
# Setează aceste variabile în Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
# Adresa care primește cererile de ofertă
LEAD_TO_EMAIL=publicsolar@yahoo.com
# Expeditorul (după ce verifici domeniul în Resend), ex.: Public Solar <site@publicsolar.ro>
LEAD_FROM_EMAIL=Public Solar <onboarding@resend.dev>
# Adresa publică a site-ului (pentru sitemap și link-uri de partajare)
NEXT_PUBLIC_SITE_URL=https://www.publicsolar.ro
